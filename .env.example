# Copia este ficheiro para .env e ajusta. O .env NUNCA deve ir para o git.
TZ=Europe/Lisbon

# =============================================================================
# Servidor
# =============================================================================
SERVER_NAME=Icarus Caseiro
JOIN_PASSWORD=muda-isto
ADMIN_PASSWORD=muda-isto-tambem
MAX_PLAYERS=4
GAME_PORT=17777
QUERY_PORT=27015

# Nome do ficheiro do prospect (sem .json) a carregar automaticamente.
# Ex.: data/Saved/PlayerData/DedicatedServer/Prospects/MundoDoPedro.json -> MundoDoPedro
LOAD_PROSPECT=
# Retoma o último prospect que estava aberto quando o servidor reinicia
RESUME_PROSPECT=True
# Segundos até o servidor voltar ao lobby se ninguém entrar / se ficar vazio (-1 = nunca)
SHUTDOWN_IF_NOT_JOINED_FOR=-1
SHUTDOWN_IF_EMPTY_FOR=-1
ALLOW_NON_ADMINS_LAUNCH=True
ALLOW_NON_ADMINS_DELETE=False

# Atualiza o jogo via SteamCMD sempre que o contentor arranca (ex.: depois de reiniciar o PC)
UPDATE_ON_START=true
# Branch beta da Steam (vazio = público)
STEAM_BRANCH=
# Se um .json em ./import já existir no servidor, substitui-o? (faz cópia .before-import antes)
IMPORT_OVERWRITE=false
# Segundos que o servidor tem para fechar ao parar/reiniciar
SHUTDOWN_TIMEOUT=60
# Quantas quedas em 30 min até desistir de reiniciar sozinho (fica parado à espera de /restart)
CRASH_LIMIT=5
# Mostra o Icarus.log em `docker compose logs icarus`
LOG_TO_STDOUT=true
# Argumentos extra para o IcarusServer.exe
EXTRA_ARGS=

# Em Linux: o teu uid/gid (comando `id`), para os ficheiros em ./data ficarem teus
PUID=1000
PGID=1000

# =============================================================================
# Discord — webhook (backups e avisos)
# =============================================================================
# Canal > Editar canal > Integrações > Webhooks > Novo webhook > Copiar URL
# Vazio = sem Discord (backups só locais)
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Icarus
# Envia os .zip dos backups para o canal
DISCORD_UPLOAD_BACKUPS=true
# Limite de upload sem Nitro/boost é 10 MB; ficheiros maiores são partidos em partes
DISCORD_MAX_FILE_MB=9.5
# Mensagens "X entrou / X saiu"
DISCORD_NOTIFY_PLAYERS=true
# Avisos de online / offline / foi abaixo
DISCORD_NOTIFY_SERVER_STATUS=true
# Avisa quando um backup falha
DISCORD_NOTIFY_ERRORS=true

# =============================================================================
# Discord — bot com comandos /status /backup /backups /restart /update (opcional)
# =============================================================================
# Vazio = bot desligado. Ver README para criar o bot.
DISCORD_BOT_TOKEN=
# ID do servidor Discord (comandos aparecem logo; sem isto podem demorar até 1h)
DISCORD_GUILD_ID=
# Quem pode usar /backup /restart /update (IDs separados por vírgula).
# Se ambos vazios: só administradores do servidor Discord.
DISCORD_ADMIN_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=

# =============================================================================
# Backups — quando
# =============================================================================
# Intervalo entre backups periódicos, em minutos (0 = desliga)
BACKUP_INTERVAL_MINUTES=60
# Só faz backup se o save mudou desde o último (evita spam quando ninguém joga)
BACKUP_ONLY_IF_CHANGED=true
# Backup quando o manager arranca
BACKUP_ON_START=true
# Backup quando um jogador sai
BACKUP_ON_PLAYER_LEAVE=true
# Espera X segundos depois de um jogador sair, para o servidor ter tempo de gravar
BACKUP_LEAVE_DELAY_SECONDS=120
# Intervalo mínimo entre backups disparados por eventos (anti-spam)
BACKUP_MIN_GAP_MINUTES=10
# Os ficheiros têm de estar sem alterações há X segundos (evita copiar a meio de uma gravação)
BACKUP_FILE_STABLE_SECONDS=15
# O que entra no backup (caminhos relativos a ./data, separados por vírgula).
# Não incluas o ServerSettings.ini se o canal for partilhado: tem as passwords.
BACKUP_PATHS=Saved/PlayerData/DedicatedServer

# =============================================================================
# Backups — quantos guardar (0 = desliga essa regra; tudo a 0 = guarda tudo)
# =============================================================================
# Locais (./backups): os últimos N + o mais recente de cada dia/semana/mês
LOCAL_KEEP_LAST=24
LOCAL_KEEP_DAILY=7
LOCAL_KEEP_WEEKLY=4
LOCAL_KEEP_MONTHLY=6

# =============================================================================
# Backups — Google Drive / outro destino via rclone (pronto mas DESLIGADO)
# =============================================================================
# Só fica ativo com RCLONE_REMOTE definido E config/rclone/rclone.conf presente. Ver README.
# Ex.: gdrive:Icarus-Backups
RCLONE_REMOTE=
RCLONE_KEEP_LAST=48
RCLONE_KEEP_DAILY=30
RCLONE_KEEP_WEEKLY=12
RCLONE_KEEP_MONTHLY=12

# =============================================================================
# Reinício diário e atualizações
# =============================================================================
# Reinicia todos os dias a esta hora (hora de TZ), SÓ se não houver ninguém a jogar
DAILY_RESTART_ENABLED=true
DAILY_RESTART_TIME=07:00
# Atualiza o jogo durante o reinício diário
DAILY_RESTART_UPDATE=true
# Se houver jogadores, volta a tentar a cada X min, e desiste ao fim de Y min
DAILY_RESTART_RETRY_MINUTES=15
DAILY_RESTART_GIVE_UP_MINUTES=240
# Verifica novas versões na Steam e atualiza assim que o servidor estiver vazio
AUTO_UPDATE_ENABLED=true
UPDATE_CHECK_MINUTES=30

# =============================================================================
# Monitorização
# =============================================================================
# URL de ping do healthchecks.io (grátis): avisa-te se o PC/internet morrer. Vazio = desligado
HEALTHCHECK_PING_URL=
HEALTHCHECK_INTERVAL_MINUTES=5
# Aviso no Discord quando o disco tem menos de X GB livres
DISK_MIN_FREE_GB=5

# =============================================================================
# Deteção de jogadores
# =============================================================================
# auto = query Steam (A2S) se o servidor responder, senão o log; a2s; log
PLAYER_DETECTION=auto
A2S_INTERVAL_SECONDS=20
# Regex para o Icarus.log (só usadas sem A2S). O grupo (?P<name>...) dá o nome do jogador.
# Vazio = valores por omissão (ver README).
PLAYER_JOIN_REGEX=
PLAYER_LEAVE_REGEX=
LOG_LEVEL=INFO
